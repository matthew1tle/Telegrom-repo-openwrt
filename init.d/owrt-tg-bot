#!/bin/sh /etc/rc.common
# init.d/owrt-tg-bot
# procd service definition. Handles crash recovery/respawn and, when the
# config is set to webhook mode, wires the CGI handler into uhttpd so
# Telegram's push requests reach scripts/webhook_cgi.lua.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/share/owrt-tg-bot/core/main.lua
CONFIG=/etc/owrt-tg-bot/config.conf
CGI_LINK=/www/cgi-bin/owrt-tg-bot-webhook

get_mode() {
    sed -n 's/^mode="\{0,1\}\([^"]*\)"\{0,1\}/\1/p' "$CONFIG" | head -n1
}

setup_webhook_cgi() {
    mkdir -p /www/cgi-bin
    ln -sf /usr/share/owrt-tg-bot/scripts/webhook_cgi.lua "$CGI_LINK"
    chmod +x /usr/share/owrt-tg-bot/scripts/webhook_cgi.lua
    /etc/init.d/uhttpd reload >/dev/null 2>&1 || true
}

teardown_webhook_cgi() {
    [ -L "$CGI_LINK" ] && rm -f "$CGI_LINK"
}

start_service() {
    [ -f "$CONFIG" ] || {
        echo "owrt-tg-bot: $CONFIG missing, run install.sh first" >&2
        return 1
    }

    if [ "$(get_mode)" = "webhook" ]; then
        setup_webhook_cgi
    else
        teardown_webhook_cgi
    fi

    procd_open_instance
    procd_set_param command /usr/bin/lua "$PROG"
    procd_set_param respawn 5 10 0   # threshold, timeout, max retries (0 = unlimited)
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/owrt-tg-bot.pid
    procd_close_instance
}

stop_service() {
    teardown_webhook_cgi
}

service_triggers() {
    procd_add_reload_trigger "owrt-tg-bot"
}
